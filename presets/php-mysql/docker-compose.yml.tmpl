# ai-dev-sandbox — php-mysql preset.
# GENERATED by install.sh from presets/php-mysql/docker-compose.yml.tmpl.
# Edit .devcontainer/sandbox.conf and re-run the installer.

services:
  app:
    build:
      context: .
      dockerfile: Dockerfile
      args:
        TZ: @@TZ@@
        USER_UID: "@@USER_UID@@"
        USER_GID: "@@USER_GID@@"
    # Required for the firewall. With compose these belong here, not in
    # devcontainer.json's runArgs. NET_ADMIN and NET_RAW only — notably NOT
    # SYS_ADMIN, which would allow remounting filesystems.
    cap_add:
      - NET_ADMIN
      - NET_RAW
    volumes:
      - ..:/workspace:cached
      # Generated directories, kept OFF the bind mount. Three reasons:
      #   1. host files are often owned by another user (www-data, root); the
      #      sandbox user can write via group but cannot chmod, which needs
      #      ownership
      #   2. host and container toolchain versions differ, so sharing built
      #      dependencies mixes incompatible native builds
      #   3. it stops this stack and any other local stack (DDEV, Lando)
      #      corrupting each other's caches
      # Generated from SANDBOX_VOLUMES — same source as the Dockerfile mkdir list.
@@VOLUME_MOUNTS@@
      - claude-config:/home/dev/.claude
      - command-history:/commandhistory
      # Package-manager caches. Without these every rebuild re-downloads
      # everything; a yarn cache alone is commonly several hundred MB.
      - user-cache:/home/dev/.cache
      - composer-cache:/home/dev/.composer
      - npm-cache:/home/dev/.npm
    environment:
      CLAUDE_CONFIG_DIR: /home/dev/.claude
      # Must sit inside the same volume as the package caches. Yarn extracts to
      # a temp dir then renames into the cache; if those are different mounts
      # the rename fails with EXDEV and yarn reports "the file appears to be
      # corrupt" on random packages.
      TMPDIR: /home/dev/.cache/tmp
      # Run Apache as the sandbox user, not www-data. Everything writable here
      # is owned by the sandbox user, so as www-data PHP cannot write session
      # files and every request logs a session_write_close() warning.
      APACHE_RUN_USER: dev
      APACHE_RUN_GROUP: dev
      NODE_OPTIONS: --max-old-space-size=4096
@@EXTRA_ENV@@
    depends_on:
      db:
        condition: service_healthy
    ports:
      - "@@HTTP_PORT@@:80"
    # The firewall is applied HERE, not only via devcontainer.json's
    # postStartCommand. postStartCommand runs only under the devcontainer CLI or
    # VS Code — starting the stack with plain `docker compose up` would skip it
    # and leave the container with NO firewall while the mode file still claimed
    # "closed". Applying it in the container's own command covers every start
    # path. It is idempotent, so postStartCommand re-applying it is harmless.
    #
    # Apache runs after, and only if the firewall succeeded.
    command:
      - /bin/sh
      - -c
      - "/usr/local/bin/init-firewall.sh || exit 1; apache2-foreground & exec sleep infinity"
    # Apache is backgrounded so the container outlives it — otherwise an httpd
    # config error would take the whole sandbox down. The trade-off is that a
    # dead Apache is invisible, so surface it here: `docker ps` shows unhealthy
    # rather than leaving you with an unexplained connection refused.
    healthcheck:
      test: ["CMD-SHELL", "curl -sf -o /dev/null http://localhost:80/ || exit 1"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 20s

  db:
    image: mysql:@@MYSQL_VERSION@@
    environment:
      MYSQL_ROOT_PASSWORD: @@DB_PASSWORD@@
      MYSQL_DATABASE: @@DB_NAME@@
    volumes:
      - db-data:/var/lib/mysql
    healthcheck:
      test: ["CMD", "mysqladmin", "ping", "-h", "localhost", "-p@@DB_PASSWORD@@"]
      interval: 5s
      timeout: 5s
      retries: 20

volumes:
@@VOLUME_DECLS@@
  claude-config:
  command-history:
  user-cache:
  composer-cache:
  npm-cache:
  db-data:

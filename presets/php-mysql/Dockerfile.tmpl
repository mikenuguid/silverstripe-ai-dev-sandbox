# ai-dev-sandbox — php-mysql preset.
# GENERATED by install.sh from presets/php-mysql/Dockerfile.tmpl.
# Edit .devcontainer/sandbox.conf and re-run the installer, or edit this file
# directly if you have outgrown the preset.

FROM php:@@PHP_VERSION@@-apache

ARG TZ=@@TZ@@
ENV TZ="$TZ"

ARG USERNAME=dev
ARG USER_UID=@@USER_UID@@
ARG USER_GID=@@USER_GID@@

# System packages.
#   - firewall tooling: iptables, ipset, iproute2, dnsutils, conntrack
#   - conntrack is required by net-close.sh; without it the flush of live
#     connections is silently skipped and open sockets survive a close
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl wget gnupg git unzip zip less nano jq sudo zsh procps \
      iptables ipset iproute2 dnsutils conntrack \
      default-mysql-client \
      libzip-dev libpng-dev libjpeg62-turbo-dev libfreetype6-dev \
      libicu-dev libonig-dev libxml2-dev libtidy-dev \
    && rm -rf /var/lib/apt/lists/*

RUN docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install -j"$(nproc)" \
       pdo_mysql mysqli intl gd zip exif opcache tidy bcmath

ENV APACHE_DOCUMENT_ROOT=/workspace/@@DOCROOT@@
RUN a2enmod rewrite headers \
    && sed -ri -e 's!/var/www/html!${APACHE_DOCUMENT_ROOT}!g' /etc/apache2/sites-available/*.conf \
    && sed -ri -e 's!/var/www/!${APACHE_DOCUMENT_ROOT}!g' /etc/apache2/apache2.conf /etc/apache2/conf-available/*.conf

RUN curl -fsSL https://deb.nodesource.com/setup_@@NODE_VERSION@@.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && npm install -g yarn \
    && rm -rf /var/lib/apt/lists/*

COPY --from=composer:2 /usr/bin/composer /usr/local/bin/composer

# USER_GID must match the group owning the host repo, or the sandbox user cannot
# write to the bind mount. install.sh defaults these to the invoking user.
RUN groupadd --gid $USER_GID $USERNAME \
    && useradd --uid $USER_UID --gid $USER_GID -m -s /bin/zsh $USERNAME

# Persisted dirs owned by the sandbox user.
#
# The generated directories MUST exist here even though they are named volumes.
# Docker seeds a new named volume from the image path it covers — if the path is
# absent, the volume is created empty and owned by root, and the package manager
# then cannot write into it. This list is generated from SANDBOX_VOLUMES in
# sandbox.conf, the same source as the compose volume list, so the two cannot
# drift apart.
RUN mkdir -p @@MKDIR_LIST@@ \
             /home/$USERNAME/.claude /commandhistory \
             /home/$USERNAME/.cache/tmp /home/$USERNAME/.composer /home/$USERNAME/.npm \
    && chown -R $USERNAME:$USERNAME /workspace /home/$USERNAME /commandhistory

COPY zshrc /home/$USERNAME/.zshrc
RUN chown $USERNAME:$USERNAME /home/$USERNAME/.zshrc

# The bind-mounted repo keeps its HOST ownership, which on a web-server path is
# often www-data (uid 33) rather than the sandbox user. git then refuses to
# operate on it. Matching UIDs cannot fix that, so declare the workspace trusted.
RUN printf '[safe]\n\tdirectory = /workspace\n' > /home/$USERNAME/.gitconfig \
    && chown $USERNAME:$USERNAME /home/$USERNAME/.gitconfig

# Apache runs as the sandbox user (set via APACHE_RUN_USER/GROUP in compose).
# Debian's envvars uses `: ${APACHE_RUN_USER:=www-data}`, a := default, so the
# environment wins and no config edit is needed. These dirs must be writable by it.
RUN chown -R $USERNAME:$USERNAME /var/log/apache2 /var/run/apache2 2>/dev/null || true

RUN npm install -g @anthropic-ai/claude-code

# ---------------------------------------------------------------------------
# Airlock. The three scripts are root-owned and not writable by $USERNAME.
# Only init-firewall.sh is in sudoers: the sandbox user can re-apply the
# firewall but cannot change the mode, because init-firewall.sh reads its
# behaviour from /etc/claude-net-mode, which is root-owned. Re-running it
# therefore re-applies the current mode and can never widen the allowlist.
# ---------------------------------------------------------------------------
COPY init-firewall.sh net-open.sh net-close.sh /usr/local/bin/
RUN chown root:root /usr/local/bin/init-firewall.sh /usr/local/bin/net-open.sh /usr/local/bin/net-close.sh \
    && chmod 0755 /usr/local/bin/init-firewall.sh /usr/local/bin/net-open.sh /usr/local/bin/net-close.sh \
    && echo "$USERNAME ALL=(root) NOPASSWD: /usr/local/bin/init-firewall.sh" > /etc/sudoers.d/$USERNAME-firewall \
    && chmod 0440 /etc/sudoers.d/$USERNAME-firewall

# The allowlist is BAKED IN, not bind-mounted.
#
# A read-only bind of .devcontainer/allowlist.txt would give no protection: the
# same file is also visible read-write under /workspace, and :ro only blocks
# writes through that mount point, not through another path to the same inode.
# The sandboxed process could edit it and then `sudo init-firewall.sh` to have
# its own additions applied. Baking it in means changing the allowlist requires
# a rebuild, which only the host can trigger.
COPY allowlist.txt /etc/sandbox-allowlist
RUN chown root:root /etc/sandbox-allowlist && chmod 0644 /etc/sandbox-allowlist

# Fail safe: a rebuild always lands closed.
RUN echo closed > /etc/claude-net-mode && chmod 0644 /etc/claude-net-mode

ENV HISTFILE=/commandhistory/.zsh_history
WORKDIR /workspace

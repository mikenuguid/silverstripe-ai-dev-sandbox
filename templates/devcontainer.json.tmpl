{
  // GENERATED by ai-dev-sandbox install.sh. Safe to edit.
  "name": "@@PROJECT_NAME@@ sandbox",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspace",
  "remoteUser": "dev",

  // The CLI rewrites the container user's uid/gid after the build by default,
  // which overrides the values set in the Dockerfile and can leave the sandbox
  // user in the wrong group. The bind-mounted repo is often owned by another
  // user with mode 775, so without the right gid there is no write access to it.
  "updateRemoteUserUID": false,

  "remoteEnv": {
    // Do not forward the SSH agent. Forwarding shares a *capability*, not a
    // secret — anything in the container could ask the agent to sign, and that
    // reaches every host the key opens. Commit inside, push from the host.
    "SSH_AUTH_SOCK": ""
  },

  // Re-applies the firewall on every start, matching /etc/claude-net-mode.
  // The compose `command` also applies it, so this is belt and braces: it is
  // idempotent, and it means a non-zero exit fails container start, which is
  // intended.
  "postStartCommand": "sudo /usr/local/bin/init-firewall.sh",
  "waitFor": "postStartCommand",

  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh"
      }
    }
  }
}
